# Firebase Web (client) config — from Firebase Console > Project settings > General > Your apps > Web app > Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Firebase Admin (server) — individual fields
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# Firebase Admin (server) — full service account JSON on one line
FIREBASE_SERVICE_ACCOUNT_KEY=

# ---- Local emulators (Spark-plan saver: dev burns ZERO production quota) ----
# 1. Copy these into apps/web/.env.local for local development:
#    NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
#    FIRESTORE_EMULATOR_HOST=localhost:8080
#    FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# 2. Run: firebase emulators:start   (ports: auth 9099, firestore 8080,
#    storage 9199, UI http://localhost:4000 — see firebase.json)
# 3. NEVER enable the emulator flag in production/Vercel.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# ---- Password reset links (public app URL embedded in Firebase reset links) ----
# Production: set to the deployed NarayanaOS origin, e.g. https://erp.yourschool.in
# The domain MUST be listed in Firebase Console > Authentication > Settings >
# Authorized domains (localhost is authorized by default). Dev default below.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Cron / scheduled jobs ----
# Secret for x-cron-secret header on PUT /api/cron/process-reminder-queue.
# Generate: openssl rand -hex 32. If unset, endpoint falls back to admin auth only.
CRON_SECRET=

# ---- Nightly Google Drive backup (GET /api/cron/drive-backup?collection=<name>) ----
# 1. Google Cloud Console -> enable the Google Drive API -> create an OAuth 2.0
#    Client ID (Web application) with redirect URI http://localhost:53682
#    (the helper's port; change with GOOGLE_DRIVE_REDIRECT_PORT).
# 2. Exchange a code once:  node scripts/get-drive-refresh-token.js
# 3. Cron schedule lives in vercel.json ("crons"). Vercel cron runs in UTC, so
#    30 20 * * * = 02:00 IST. Vercel's plan limits how many cron jobs you may
#    define (Hobby allows 2) - use Pro or collapse the entries if deploy fails.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Target folder id (the long string in the Drive folder URL). Empty = My Drive root.
GOOGLE_DRIVE_FOLDER_ID=

# ---- Multi-school scoping ----
# Default school id when token has no school_id/schoolId claim.
SCHOOL_ID=default-school

# ---- Mobile push notifications (Phase 5 backlog — manual steps, nothing automated) ----
# Deep links already work: apps/mobile/app.json declares scheme "sna" and
# expo-linking is installed, so sna://<route> opens expo-router screens.
# Push needs credentials that cannot be generated in code:
# 1. npx expo install expo-notifications   (from apps/mobile)
# 2. eas init                              (writes extra.eas.projectId into apps/mobile/app.json)
# 3. Add the expo-notifications plugin to app.json + FCM google-services.json / APNs key.
# 4. Build profiles are ready in apps/mobile/eas.json.
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_FCM_SENDER_ID=
