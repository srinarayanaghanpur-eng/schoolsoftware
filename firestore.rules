rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // ---- Role resolution -------------------------------------------------
    // Prefer the Firebase custom-claim fields (role / status / teacherId),
    // which cost ZERO Firestore reads, and fall back to the users/{uid}
    // document only for legacy accounts whose claims predate those fields.
    // The web API sets all three claims whenever a user or teacher is created
    // or updated, so the claim is authoritative. Trade-off: a role/status
    // change is written to the claim server-side immediately, but a signed-in
    // client keeps its cached ID token for up to ~1h until it refreshes.
    //
    // This is deliberate: the previous rules called get() up to 3x per teacher
    // request, multiplying billed reads and exhausting the Firestore free-tier
    // daily quota.
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function effectiveRole() {
      return request.auth.token.role != null
        ? request.auth.token.role
        : userDoc().role;
    }

    function effectiveStatus() {
      return request.auth.token.status != null
        ? request.auth.token.status
        : userDoc().status;
    }

    function effectiveTeacherId() {
      return request.auth.token.teacherId != null
        ? request.auth.token.teacherId
        : userDoc().teacherId;
    }

    function isAdmin() {
      return signedIn() && (effectiveRole() == "admin" || effectiveRole() == "super_admin");
    }

    // Shared read gate for transport master data and driver records.
    function isAdminOrPrincipal() {
      return isAdmin() || isPrincipal();
    }

    function isSettingsManager() {
      return signedIn() && effectiveRole() == "settings_manager";
    }

    function isSuperAdmin() {
      return signedIn() && effectiveRole() == "super_admin";
    }

    function isFinanceRole() {
      return signedIn() && (
        effectiveRole() == "super_admin" ||
        effectiveRole() == "admin" ||
        effectiveRole() == "accountant"
      );
    }

    function isActiveTeacher() {
      return signedIn() && effectiveRole() == "teacher" && effectiveStatus() == "active";
    }

    function isTeacher() {
      return isActiveTeacher();
    }

    function isDriver() {
      return signedIn() && effectiveRole() == "driver" && effectiveStatus() == "active";
    }

    // Every back-office role, including teachers. Used to keep finance,
    // transport, library and inventory collections out of the parent portal.
    function isStaff() {
      return signedIn() && (
        effectiveRole() == "super_admin" ||
        effectiveRole() == "admin" ||
        effectiveRole() == "settings_manager" ||
        effectiveRole() == "principal" ||
        effectiveRole() == "accountant" ||
        effectiveRole() == "teacher"
      );
    }

    function isOwnTeacherProfile() {
      return isActiveTeacher() && resource.data.uid == request.auth.uid;
    }

    function isOwnTeacherId(teacherId) {
      return isActiveTeacher() && effectiveTeacherId() == teacherId;
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      // Every users-doc mutation goes through the admin API (validation,
      // custom-claim sync, audit logging). Clients never write directly —
      // this previously let any admin client-edit arbitrary user documents.
      allow write: if false;
    }

    match /teachers/{teacherId} {
      allow read: if isAdmin() || isOwnTeacherProfile();
      allow write: if isAdmin();
    }

    // Face embeddings are biometric templates. They are never exposed to a
    // Firestore client; approved kiosk devices receive them through the
    // authenticated API only, and every read/write goes through the Admin SDK.
    match /teacher_faces/{teacherId} {
      allow read, write: if false;
    }

    // Shared face devices are registered and approved through the API.
    match /face_devices/{deviceId} {
      allow read, write: if false;
    }

    // Face kiosk audit trail: admins may read, only the Admin SDK writes.
    match /face_attendance_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin() || isOwnTeacherId(resource.data.teacherId);
      // Server-only: geofence/time-window enforcement lives in
      // POST /api/attendance/mark, which writes via the Admin SDK.
      allow write: if false;
    }

    // Student daily attendance. Read-only for staff; all writes go through
    // POST /api/admin/student-attendance (Admin SDK) so the roster, school,
    // and academic-year scope are enforced server-side.
    match /student_attendance/{recordId} {
      allow read: if isAdmin() || isPrincipal();
      allow write: if false;
    }

    // Academic master data (subjects, periods). Read-only for staff; writes go
    // through the /api/admin/subjects and /api/admin/periods routes.
    match /subjects/{subjectId} {
      allow read: if isAdmin() || isPrincipal() || isActiveTeacher();
      allow write: if false;
    }

    match /periods/{periodId} {
      allow read: if isAdmin() || isPrincipal() || isActiveTeacher();
      allow write: if false;
    }

    // ===== Setup masters (managed via /api/admin/masters/*) =====
    function isMasterReader() {
      return isAdmin() || isPrincipal() || isAccountant() || isActiveTeacher();
    }

    match /exam_types/{id} {
      allow read: if isMasterReader();
      allow write: if false;
    }
    match /grades/{id} {
      allow read: if isMasterReader();
      allow write: if false;
    }
    match /cocurricular_areas/{id} {
      allow read: if isMasterReader();
      allow write: if false;
    }
    match /assessment_types/{id} {
      allow read: if isMasterReader();
      allow write: if false;
    }
    match /departments/{id} {
      allow read: if isAdmin() || isPrincipal() || isActiveTeacher();
      allow write: if false;
    }
    match /designations/{id} {
      allow read: if isAdmin() || isPrincipal() || isActiveTeacher();
      allow write: if false;
    }
    match /leave_types/{id} {
      allow read: if isAdmin() || isPrincipal() || isActiveTeacher();
      allow write: if false;
    }
    match /salary_templates/{id} {
      allow read: if isAdmin() || isPrincipal();
      allow write: if false;
    }
    match /appraisal_criteria/{id} {
      allow read: if isAdmin() || isPrincipal();
      allow write: if false;
    }
    match /fee_types/{id} {
      allow read: if isAdmin() || isAccountant() || isPrincipal();
      allow write: if false;
    }
    match /fee_groups/{id} {
      allow read: if isAdmin() || isAccountant() || isPrincipal();
      allow write: if false;
    }
    match /income_heads/{id} {
      allow read: if isAdmin() || isAccountant() || isPrincipal();
      allow write: if false;
    }
    match /expense_heads/{id} {
      allow read: if isAdmin() || isAccountant() || isPrincipal();
      allow write: if false;
    }
    match /bank_accounts/{id} {
      allow read: if isAdmin() || isAccountant() || isPrincipal();
      allow write: if false;
    }
    match /student_houses/{id} {
      allow read: if isMasterReader();
      allow write: if false;
    }
    match /student_categories/{id} {
      allow read: if isMasterReader();
      allow write: if false;
    }
    match /buildings/{id} {
      allow read: if isMasterReader();
      allow write: if false;
    }
    match /id_card_designs/{id} {
      allow read: if isMasterReader();
      allow write: if false;
    }
    match /compliance_packs/{id} {
      allow read: if isAdmin() || isPrincipal();
      allow write: if false;
    }
    match /survey_templates/{id} {
      allow read: if isAdmin() || isPrincipal() || isActiveTeacher();
      allow write: if false;
    }
    match /staff_loans/{id} {
      allow read: if isAdmin() || isPrincipal() || isAccountant();
      allow write: if false;
    }
    match /appraisals/{id} {
      allow read: if isAdmin() || isPrincipal() || isAccountant();
      allow write: if false;
    }
    match /classrooms/{id} {
      allow read: if isMasterReader();
      allow write: if false;
    }
    match /compliance_items/{id} {
      allow read: if isAdmin() || isPrincipal();
      allow write: if false;
    }
    match /surveys/{id} {
      allow read: if isAdmin() || isPrincipal() || isActiveTeacher() || request.auth != null;
      allow write: if false;
    }
    match /assessments/{id} {
      allow read: if isMasterReader();
      allow write: if false;
    }
    match /gallery_albums/{id} {
      allow read: if isAdmin() || isPrincipal() || isActiveTeacher() || request.auth != null;
      allow write: if false;
    }
    match /qr_sessions/{id} {
      allow read: if isAdmin() || isPrincipal() || isActiveTeacher();
      allow write: if false;
    }
    match /ptm_meetings/{id} {
      allow read: if isAdmin() || isPrincipal() || isActiveTeacher() || request.auth != null;
      allow write: if false;
    }
    match /ptm_records/{id} {
      allow read: if isAdmin() || isPrincipal() || isActiveTeacher();
      allow write: if false;
    }
    match /lesson_plans/{id} {
      allow read: if isAdmin() || isPrincipal() || isActiveTeacher();
      allow write: if false;
    }
    match /exam_schedules/{id} {
      allow read: if isMasterReader();
      allow write: if false;
    }
    match /exam_remarks/{id} {
      allow read: if isAdmin() || isPrincipal() || isActiveTeacher();
      allow write: if false;
    }
    match /custom_fields/{id} {
      allow read: if isAdmin() || isPrincipal();
      allow write: if false;
    }
    match /module_toggles/{id} {
      allow read: if isAdmin() || isPrincipal() || isActiveTeacher();
      allow write: if false;
    }
    match /payment_gateways/{id} {
      allow read: if isAdmin() || isAccountant();
      allow write: if false;
    }
    match /subscription_plans/{id} {
      allow read: if isAdmin() || isPrincipal();
      allow write: if false;
    }

    // Communication gateway settings and send logs — server-only writes.
    match /communication_settings/{id} {
      allow read: if isAdmin() || isPrincipal();
      allow write: if false;
    }
    match /communication_logs/{id} {
      allow read: if isAdmin() || isPrincipal();
      allow write: if false;
    }

    match /attendance_logs/{logId} {
      allow read: if isAdmin() || isOwnTeacherId(resource.data.teacherId);
      // Audit log is written exclusively by the Admin SDK through
      // POST /api/attendance/mark (and the biometric ingest route).
      allow write: if false;
    }

    match /biometric_logs/{logId} {
      allow read: if isAdmin();
      // Ingested by the Admin SDK (biometric webhook route) only.
      allow write: if false;
    }

    match /salary_reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Password reset requests: admins review/approve/reject/archive; a teacher
    // may only create their own request. Hard delete is super-admin only.
    match /password_reset_requests/{requestId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isOwnTeacherId(request.resource.data.teacherId);
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /password_reset_history/{historyId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /leave_requests/{requestId} {
      allow read: if isAdmin() || isOwnTeacherId(resource.data.teacherId);
      // Teachers may only file a request that starts as "pending" — approval
      // is an admin-only transition (approved leaves feed payroll calculations,
      // so a self-approved request would directly inflate salary deductions).
      allow create: if isAdmin() ||
        (isOwnTeacherId(request.resource.data.teacherId) && request.resource.data.status == "pending");
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // Canonical audit trail — written exclusively by the Admin SDK through the
    // API layer. Clients may neither read nor write it (the catch-all deny
    // below also enforces this; kept explicit so it survives future edits).
    match /audit_logs/{entryId} {
      allow read, write: if false;
    }

    // Attendance edit audit logs are permanent audit records: admins may read
    // and append/annotate (archive/soft-hide), but NEVER delete from a client.
    match /attendance_edit_audit_logs/{auditId} {
      allow read: if isAdmin();
      // Server-only: appended by the attendance edit API route.
      allow write: if false;
    }

    match /admin_notifications/{notificationId} {
      allow read, write: if isAdmin();
    }

    match /holidays/{holidayId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Settings documents (school, payment, admissions, class-sections, ...).
    // SECURITY: teachers/parents/students must never read these — settings/school
    // stores the biometric webhook secret. Principal/accountant may read the
    // non-secret settings docs, but `settings/school` is admin/settings_manager
    // only. Writes stay limited to admin/settings_manager.
    match /settings/{settingsId} {
      allow read: if isAdmin() || isSettingsManager() ||
        ((isPrincipal() || isAccountant()) && settingsId != "school");
      allow write: if isAdmin() || isSettingsManager();
    }

    // RBAC role documents are read by the app shell for live client-side
    // permission gating. Writes must go through the admin API so validation,
    // lockout protection, and audit logging are enforced server-side.
    match /roles/{roleId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Academic years: any signed-in user can read the active year; writes go via admin SDK.
    match /academic_years/{yearId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Phase 2: exams, marks, notices. Reads for signed-in users; writes via admin SDK
    // (the API routes enforce per-role permissions).
    match /exams/{examId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    // Marks contain student PII — never expose to every signed-in user.
    // Direct client reads: staff only. Parents/students must use the portal
    // API (admin SDK) which enforces parent_student_links ownership.
    match /exam_marks/{markId} {
      allow read: if isAdmin() || isActiveTeacher() || isFinanceRole() || isPrincipal();
      allow write: if isAdmin();
    }
    match /notices/{noticeId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Phase 3: fee structures + online payment orders. Writes/orders go via admin SDK.
    match /fee_structures/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /payment_orders/{id} {
      allow read, write: if isAdmin();
    }

    // Finance/accounting: sensitive — admin/accountant via admin SDK (API enforces role).
    match /expenses/{id} {
      allow read, write: if isAdmin();
    }
    // Change approvals: server-only (API enforces approver roles). No client access.
    match /approvals/{approvalId} {
      allow read, write: if false;
    }
    // Staff tasks: server-only (API enforces assigner/owner roles). No client access.
    match /tasks/{taskId} {
      allow read, write: if false;
    }
    match /debitVouchers/{id} {
      allow read: if isFinanceRole();
      // Server-only: written by the finance API routes (Admin SDK).
      allow write: if false;
    }
    match /incomes/{id} {
      allow read, write: if isAdmin();
    }
    match /salary_advances/{id} {
      allow read, write: if isAdmin();
    }
    match /vendors/{id} { allow read, write: if isAdmin(); }
    match /purchases/{id} { allow read, write: if isAdmin(); }
    match /bank_accounts/{id} { allow read, write: if isAdmin(); }
    match /bank_transactions/{id} { allow read, write: if isAdmin(); }
    match /invoices/{id} { allow read, write: if isAdmin(); }
    match /fee_reminders/{id} { allow read, write: if isAdmin(); }
    // Reminder provider keys (smsApiKey, whatsappApiKey) live here — admin only.
    match /fee_reminder_settings/{id} { allow read: if isAdmin(); allow write: if false; }
    match /fee_reminder_queue/{id} { allow read: if isAdmin() || isAccountant(); allow write: if false; }
    match /fee_reminder_logs/{id} { allow read: if isAdmin() || isAccountant(); allow write: if false; }
    match /student_reminder_consent/{id} { allow read: if isAdmin() || isAccountant(); allow write: if isAdmin(); }
    match /counters/{id} {
      allow read: if isFinanceRole();
      // Receipt-number allocation must be atomic on the server.
      allow write: if false;
    }

    // Phase 4: transport, library, hostel, inventory. Reads are staff-only;
    // writes via admin SDK (API enforces per-role permissions). Parent portal
    // reads go through /api/portal/* with a server-side student-link check.
    match /vehicles/{id} { allow read: if isAdmin() || isPrincipal(); allow write: if isAdmin(); }
    match /transport_routes/{id} { allow read: if isAdmin() || isPrincipal(); allow write: if isAdmin(); }
    match /transport_assignments/{id} { allow read: if isAdmin(); allow write: if isAdmin(); }

    // Driver portal collections. Drivers may read only their own driver profile,
    // trips and trip stops; every write goes through the Admin SDK (driver /
    // transport API routes), so client writes are denied outright.
    match /drivers/{driverId} {
      allow read: if isAdminOrPrincipal() || (isDriver() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }
    match /transport_trips/{tripId} {
      allow read: if isAdminOrPrincipal() || (isDriver() && resource.data.driverUid == request.auth.uid);
      allow write: if false;
    }
    match /transport_trip_stops/{stopId} {
      allow read: if isAdminOrPrincipal() || (isDriver() && resource.data.driverUid == request.auth.uid);
      allow write: if false;
    }
    match /transport_baselines/{routeId} {
      allow read: if isAdminOrPrincipal();
      allow write: if false;
    }
    match /books/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /library_issues/{id} { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /hostel_rooms/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /hostel_allotments/{id} { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /inventory_items/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /inventory_sales/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /inventory_movements/{id} { allow read: if isAdmin(); allow write: if isAdmin(); }

    // Bus EMI / Vehicle Finance — admin/accountant only. All writes go via the
    // admin SDK (API routes enforce bus_finance.* permissions); delete is
    // admin-only at the API layer. Separate from the student transport module.
    match /bus_finance/{id} {
      allow read: if isAdmin() || isAccountant();
      allow write: if false;
    }
    match /bus_emi_payments/{id} {
      allow read: if isAdmin() || isAccountant();
      allow write: if false;
    }

    match /backup_audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Fee Concession Management Rules
    function isAccountant() {
      return signedIn() && effectiveRole() == "accountant";
    }

    function isPrincipal() {
      return signedIn() && effectiveRole() == "principal";
    }

    // Concessions collection
    match /concessions/{concessionId} {
      allow read: if isAdmin() || isAccountant() || isPrincipal();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isPrincipal() && request.resource.data.status != resource.data.status);
      allow delete: if isAdmin();
    }

    // NOTE: Fee structures use the canonical snake_case collection `fee_structures`
    // (defined above). The legacy camelCase `feeStructures` rule block was removed
    // to eliminate the split-brain collection naming. Accountant/Principal retain
    // read access to `fee_structures` through the staff role set; writes remain
    // admin-only.

    // Payments collection
    match /payments/{paymentId} {
      allow read: if isAdmin() || isAccountant() || isPrincipal();
      // Server-only: fee collection writes via the admin API (amount checks,
      // receipt numbering, audit logging).
      allow write: if false;
    }

    // Receipts collection
    match /receipts/{receiptId} {
      allow read: if isAdmin() || isAccountant() || isPrincipal();
      allow write: if false;
    }

    match /receipt_counters/{counterId} {
      allow read: if isAdmin() || isAccountant();
      allow write: if false;
    }

    // Late-fee policy master. Server-only writes via /api/admin/fee-fine-rules.
    match /fee_fine_rules/{ruleId} {
      allow read: if isAdmin() || isAccountant() || isPrincipal();
      allow write: if false;
    }

    // Offline fee challans and due slips — server writes via admin API only.
    match /fee_challans/{challanId} {
      allow read: if isAdmin() || isAccountant() || isPrincipal();
      allow write: if false;
    }
    match /due_slips/{slipId} {
      allow read: if isAdmin() || isAccountant() || isPrincipal();
      allow write: if false;
    }

    // Student behavior, health and exit records — read for staff, server writes only.
    match /student_behavior/{recordId} {
      allow read: if isAdmin() || isPrincipal() || isTeacher();
      allow write: if false;
    }
    match /student_health/{recordId} {
      allow read: if isAdmin() || isPrincipal() || isTeacher();
      allow write: if false;
    }
    match /student_exits/{recordId} {
      allow read: if isAdmin() || isPrincipal() || isTeacher();
      allow write: if false;
    }

    // Audit logs for fee operations
    match /feeAuditLogs/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ===== Students & Parent Portal =====
    // NOTE: parent reads go through the portal API (admin SDK +
    // parent_student_links check). Direct client reads are staff-only because
    // link IDs are random and cannot be securely checked in rules alone.
    match /students/{studentId} {
      allow read: if isAdmin() || isOwnTeacherId(resource.data.teacherId);
      allow write: if isAdmin();
    }

    match /parent_student_links/{linkId} {
      allow read: if isAdmin() || isOwnLink(resource.data.parentUid);
      allow write: if isAdmin();
    }

    match /parent_messages/{msgId} {
      allow read: if isAdmin() || isOwnMessage(resource.data.parentUid);
      allow create: if signedIn()
        && request.resource.data.parentUid == request.auth.uid
        && request.resource.data.keys().hasAll(['parentUid', 'message']);
      allow update: if isAdmin();
    }

    match /approval_requests/{reqId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Fixed parent-link check: link docs use random IDs with {parentUid, studentId}
    // fields, so rules cannot securely resolve ownership without a query.
    // Keep the helper deny-closed and enforce ownership in the portal API.
    function isParentOfStudent(studentId) {
      return false;
    }

    function isOwnLink(parentUid) {
      return signedIn() && request.auth.uid == parentUid;
    }

    function isOwnMessage(parentUid) {
      return signedIn() && request.auth.uid == parentUid;
    }

    // ===== Homework (Phase 3) =====
    match /homework/{hwId} {
      allow read: if isAdmin() || isActiveTeacher();
      allow write: if isAdmin();
    }
    match /homework_submissions/{subId} {
      allow read: if isAdmin() || isActiveTeacher();
      allow create: if signedIn()
        && (
          request.resource.data.parentUid == request.auth.uid
          || request.resource.data.teacherId == effectiveTeacherId()
        );
      allow update: if isAdmin() || isActiveTeacher();
    }

    // ===== Timetable (Phase 4) =====
    match /timetable/{entryId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ===== Student QR tokens =====
    // Short-lived capabilities issued and resolved exclusively by the Admin
    // SDK (POST/GET /api/student-qr). No client SDK access, ever.
    match /student_qr_tokens/{tokenId} {
      allow read, write: if false;
    }

    // ===== Backup audit log =====
    // Written only by the Admin SDK (GET /api/cron/drive-backup). Records which
    // collections were exported and which secret fields were stripped.
    match /backup_logs/{logId} {
      allow read, write: if false;
    }

    // ===== Push tokens =====
    // Written only by the Admin SDK (POST /api/push/register + unregister,
    // and server-side sends). No client SDK access, ever.
    match /push_tokens/{tokenHash} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
