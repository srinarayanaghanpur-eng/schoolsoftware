# Mobile env template — copy to .env.local and fill in (NEVER commit .env.local).
# Values live in Firebase Console > Project settings, plus your computer's
# address on the home/office Wi-Fi for EXPO_PUBLIC_WEB_API_URL.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Web backend the parent/teacher screens read data from (run `npm run dev:web`).
EXPO_PUBLIC_WEB_API_URL=http://192.168.1.11:3000
