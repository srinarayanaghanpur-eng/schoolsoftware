{
  "expo": {
    "name": "Sri Narayana High School – School ERP",
    "slug": "sri-narayana-school-erp",
    "scheme": "sna",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "runtimeVersion": "1.0.0",
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Sri Narayana School ERP to use your location for campus attendance."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3033a1"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.srinarayana.attendance",
      "buildNumber": "1"
    },
    "android": {
      "versionCode": 1,
      "package": "com.srinarayana.attendance",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "39b21e76-f36a-41eb-9681-5b457c64f2fc"
      }
    },
    "owner": "narayana2s-team"
  }
}
