{
  "expo": {
    "name": "NarayanaOS",
    "slug": "sri-narayana-school-erp",
    "scheme": "sna",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "runtimeVersion": "1.0.1",
    "updates": {
      "url": "https://u.expo.dev/39b21e76-f36a-41eb-9681-5b457c64f2fc",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow NarayanaOS to use your location for campus attendance.",
          "locationAlwaysPermission": "Allow NarayanaOS to track the school bus during active driver journeys, even when the screen is off.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3033a1"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NarayanaOS to take an attendance selfie for verification."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow NarayanaOS to use Face ID to unlock the app."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "buildArchs": ["arm64-v8a"]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/LOGO.png",
          "resizeMode": "contain",
          "backgroundColor": "#f4f3f8"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.srinarayana.attendance",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow NarayanaOS to use the camera for teacher face attendance."
      }
    },
    "android": {
      "versionCode": 8,
      "package": "com.srinarayana.attendance",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#f4f3f8"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "39b21e76-f36a-41eb-9681-5b457c64f2fc"
      }
    },
    "owner": "narayana2s-team"
  }
}
